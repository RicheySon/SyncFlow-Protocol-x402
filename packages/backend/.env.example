CRONOS_CHAIN_ID=25
PRIVATE_KEY=

# x402 Facilitator
X402_FACILITATOR_URL=https://facilitator.cronos.org
X402_API_KEY=

# Crypto.com AI Agent SDK
CRYPTO_COM_API_KEY=
CRYPTO_COM_API_SECRET=

# Contract Addresses (deployed on Cronos Mainnet)
AGENT_WALLET_ADDRESS=
PAYMENT_ROUTER_ADDRESS=
CONDITIONAL_EXECUTOR_ADDRESS=
