# Backend specific vars
PORT=3001
NODE_ENV=development
DATABASE_URL="postgresql://neondb_owner:password@host/neondb?sslmode=require"
JWT_SECRET="super-secret-dev-key-for-hackathon-only"
CRONOS_RPC_URL="https://evm-t3.cronos.org"
CRONOS_CHAIN_ID="338"CDC_DASHBOARD_API_KEY="your_cdc_api_key_here"

# ========================================
# AI PROVIDERS (pick at least one)
# Priority: Gemini > Claude > OpenAI > Ollama
# ========================================

# 1. GEMINI (Google - FREE tier available)
# Get key: https://ai.google.dev/tutorials/setup
GEMINI_API_KEY="your_gemini_api_key_here"

# 2. CLAUDE (Anthropic)
# Get key: https://console.anthropic.com/
ANTHROPIC_API_KEY="your_anthropic_api_key_here"

# 3. OPENAI (GPT-3.5-turbo)
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-your_openai_api_key_here"

# 4. OLLAMA (Local open-source models - FREE)
# Install: https://ollama.ai
# Models: llama2, mistral, neural-chat, etc.
OLLAMA_API_URL="http://localhost:11434"
OLLAMA_MODEL="llama2"