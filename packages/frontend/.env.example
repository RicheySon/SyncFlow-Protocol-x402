# Frontend Environment Variables

# Backend API URL (use Render URL in production)
BACKEND_URL=http://localhost:3001

# Public variables (exposed to browser)
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_CRONOS_CHAIN_ID=338
NEXT_PUBLIC_CRONOS_RPC_URL=https://evm-t3.cronos.org
NEXT_PUBLIC_CRONOS_EXPLORER=https://cronos.org/explorer
NEXT_PUBLIC_CONTRACT_AGENT_WALLET=
NEXT_PUBLIC_CONTRACT_PAYMENT_ROUTER=
NEXT_PUBLIC_CONTRACT_CONDITIONAL_EXECUTOR=
NEXT_PUBLIC_X402_FACILITATOR_URL=

# Database (required for Prisma)
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# JWT Secret (must match backend)
JWT_SECRET="super-secret-dev-key-for-hackathon-only"
