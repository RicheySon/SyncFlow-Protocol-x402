        "@types/node": "^20.10.0",
        "hardhat": "^2.19.2",
        "hardhat-gas-reporter": "^1.0.9",
        "solidity-coverage": "^0.8.5",
        "ts-node": "^10.9.2",
        "typescript": "^5.3.2"
    },
    "dependencies": {
        "@openzeppelin/contracts": "^5.0.1",
        "dotenv": "^16.3.1",
